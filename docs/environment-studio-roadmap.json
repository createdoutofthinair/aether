  "stages": [
    {
      "id": "E0",
      "title": "Baseline",
      "status": "planned",
      "dependsOn": [],
      "exitCriteria": [
        "Reference fixtures reproduce current city, trees and ships.",
        "Existing capability inventory distinguishes complete and missing features."
      ]
    },
    {
      "id": "E1",
      "title": "Shared foundation",
      "status": "planned",
      "dependsOn": [
        "E0"
      ],
      "exitCriteria": [
        "Versioned asset contract, registry, shared studio host and job ownership work.",
        "A recipe restores identically in its owning lab and a compatibility fixture."
      ]
    },
    {
      "id": "E2",
      "title": "Surface and facade",
      "status": "planned",
      "dependsOn": [
        "E1"
      ],
      "exitCriteria": [
        "Metric materials, facade bay/corner, windows, entry and roof parts pass lighting/LOD review."
      ]
    },
    {
      "id": "E3",
      "title": "Streets",
      "status": "planned",
      "dependsOn": [
        "E1",
        "E2"
      ],
      "exitCriteria": [
        "Profile, curve, junction, grade, drainage and markings fit without seams."
      ]
    },
    {
      "id": "E4",
      "title": "Public components",
      "status": "planned",
      "dependsOn": [
        "E1",
        "E2"
      ],
      "exitCriteria": [
        "Furniture, signs, fixtures and technical attachments pass fit and population checks."
      ]
    },
    {
      "id": "E5",
      "title": "Transit structures",
      "status": "planned",
      "dependsOn": [
        "E1",
        "E3"
      ],
      "exitCriteria": [
        "Guideway, supports, platform/station and vertical circulation share valid interfaces."
      ]
    },
    {
      "id": "E6",
      "title": "Vehicles",
      "status": "planned",
      "dependsOn": [
        "E1",
        "E2",
        "E5"
      ],
      "exitCriteria": [
        "Passenger pod passes body, running gear, doors, motion, stopping and docking tests.",
        "Additional vehicle families remain independent catalogue tasks."
      ]
    },
    {
      "id": "E7",
      "title": "Plantlife extensions",
      "status": "planned",
      "dependsOn": [
        "E1"
      ],
      "exitCriteria": [
        "Existing trees match their authoring/forest specimens through the shared adapter.",
        "Shrub, grass and ground-cover studies pass form, patch, wind and distance checks.",
        "Additional botanical studies use the same independent authoring contract."
      ]
    },
    {
      "id": "E8",
      "title": "Landscape",
      "status": "planned",
      "dependsOn": [
        "E3",
        "E4",
        "E7"
